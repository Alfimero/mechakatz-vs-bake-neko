# URL publica que entregara el proxy HTTPS, sin slash final.
MECHA_PUBLIC_URL=https://juego.example.com

# En produccion usa secretos largos, distintos y administrados fuera del repo.
MECHA_TOKEN_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
MECHA_HOST_KEY=CAMBIAR_POR_LA_CLAVE_PRIVADA_DEL_ANFITRION
MECHA_ALLOW_OPEN_CREATE=false

# Origenes separados por coma. Incluye null solo si el juego se abre con file://.
MECHA_ALLOWED_ORIGINS=https://juego.example.com,null

# STUN ayuda a descubrir rutas; TURN es necesario para NAT restrictivo.
MECHA_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"usuario","credential":"secreto"}]

